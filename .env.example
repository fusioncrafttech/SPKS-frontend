# Deployed backend
EXPO_PUBLIC_API_URL=https://spks-exams-backend.vercel.app

# Razorpay key used by the in-app checkout screen
# EXPO_PUBLIC_RAZORPAY_KEY_ID=rzp_test_xxx

# Local backend (uncomment to use instead of the deployed URL)
# Android emulator: http://10.0.2.2:4000
# iOS simulator/web: http://localhost:4000
# Physical device: use the computer's LAN IP, for example http://192.168.1.10:4000
# EXPO_PUBLIC_API_URL=http://localhost:4000
